{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"], "allowJs": true, "noEmit": true,
    "module": "esnext", "moduleResolution": "bundler", "jsx": "react-jsx", "incremental": true,
    "isolatedModules": true, "plugins": [{ "name": "next" }], "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts", "test/**/*.ts", "test/**/*.tsx", "vitest.config.ts"],
  "exclude": ["node_modules"]
}
