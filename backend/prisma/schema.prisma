generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkflowKind {
  TECHNICAL_CLEARANCE
  PROJECT_IMPLEMENTATION
  UAT_CONFORMITY
  CERTIFICATION
}

// Minimal authoritative anchor. Module 2 will own creation; Module 0 exposes no project CRUD.
model Project {
  id            String   @id @db.Uuid
  institutionId String
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  createdBy     String
  updatedBy     String
  version       Int      @default(0)
  workflows     WorkflowInstance[]
  documents     Document[]
  auditEvents   AuditEvent[]
  @@index([institutionId])
}

model Document {
  id        String @id @default(uuid()) @db.Uuid
  projectId String @db.Uuid
  type      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  createdBy String
  updatedBy String
  version   Int @default(0)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  versions  DocumentVersion[]
  @@index([projectId, type])
}

model DocumentVersion {
  id         String @id @default(uuid()) @db.Uuid
  documentId String @db.Uuid
  number     Int
  objectKey  String @unique
  checksum   String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  createdBy  String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  evidence   TransitionEvidence[]
  @@unique([documentId, number])
}

model WorkflowInstance {
  id                String @id @default(uuid()) @db.Uuid
  projectId         String @db.Uuid
  kind              WorkflowKind
  definitionKey     String
  definitionVersion Int
  state             String
  evidenceRevision  Int @default(1)
  version           Int @default(0)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)
  createdBy         String
  updatedBy         String
  project           Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  transitions       WorkflowTransition[]
  @@unique([id, projectId])
  @@index([projectId, kind])
}

model AuditEvent {
  id            String @id @default(uuid()) @db.Uuid
  projectId     String? @db.Uuid
  actorId       String
  actorRole     String
  institutionId String
  action        String
  subjectType   String
  subjectId     String
  correlationId String
  result        String
  payload       Json
  timestamp     DateTime @default(now()) @db.Timestamptz(3)
  project       Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)
  transition    WorkflowTransition?
  @@index([projectId, timestamp])
  @@index([correlationId])
}

model WorkflowTransition {
  id                String @id @default(uuid()) @db.Uuid
  instanceId        String @db.Uuid
  projectId         String @db.Uuid
  requestId         String @db.Uuid
  currentState      String
  targetState       String
  authorizedRole    String
  stage             String
  requiredConditions Json
  requiredDocuments Json
  validation        Json
  actorId           String
  institutionId     String
  timestamp         DateTime @default(now()) @db.Timestamptz(3)
  comments          String
  auditReference    String @unique @db.Uuid
  evidenceRevision  Int
  expectedVersion   Int
  resultingVersion  Int
  instance          WorkflowInstance @relation(fields: [instanceId, projectId], references: [id, projectId], onDelete: Restrict)
  audit             AuditEvent @relation(fields: [auditReference], references: [id], onDelete: Restrict)
  evidence          TransitionEvidence[]
  @@unique([instanceId, requestId])
  @@index([projectId, timestamp])
}

model TransitionEvidence {
  transitionId      String @db.Uuid
  documentVersionId String @db.Uuid
  transition        WorkflowTransition @relation(fields: [transitionId], references: [id], onDelete: Restrict)
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)
  @@id([transitionId, documentVersionId])
}
