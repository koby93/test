# Local development only; these are synthetic defaults, never production credentials.
POSTGRES_USER=nita
POSTGRES_PASSWORD=development-only-database
POSTGRES_DB=nita
DATABASE_URL=postgresql://nita:development-only-database@localhost:5432/nita
REDIS_PASSWORD=development-only-cache
REDIS_URL=redis://:development-only-cache@localhost:6379
MINIO_ROOT_USER=nita-development
MINIO_ROOT_PASSWORD=development-only-storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=nita-development
S3_SECRET_KEY=development-only-storage
S3_BUCKET=nita-records
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://localhost:4000
API_PUBLIC_URL=http://localhost:4000
OIDC_ENABLED=false
OIDC_REQUIRE_MFA=false
# Set all three when connecting an identity provider.
# OIDC_ISSUER_URL=http://localhost:8080/realms/nita
# OIDC_JWKS_URI=http://localhost:8080/realms/nita/protocol/openid-connect/certs
# OIDC_AUDIENCE=nita-platform-api
# OIDC_MFA_ACR=urn:nita:assurance:mfa
